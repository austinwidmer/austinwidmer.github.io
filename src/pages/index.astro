---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import profileImage from "@/assets/images/profile/AW_profile.jpg";

const metadata = {
  title: "Austin Widmer | Aerospace Engineering and Research",
  description:
    "Aerospace engineering research, professional experience, and weightlifting coaching.",
  ignoreTitleTemplate: true,
};
const publications = (await getCollection("publications")).sort(
  (first, second) => second.data.pubDate.getTime() - first.data.pubDate.getTime(),
);
const featuredPublications = publications.slice(0, 2);
---

<BaseLayout {metadata}>
  <section class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-[1.4fr_0.6fr] md:py-24 lg:px-8">
    <div>
      <p class="mb-5 text-sm font-semibold uppercase text-primary">
        Aerospace engineering · Astrodynamics · Coaching
      </p>
      <h1 class="max-w-3xl text-5xl font-semibold leading-tight sm:text-6xl">
        Austin Widmer
      </h1>
      <p class="mt-6 max-w-2xl text-xl leading-relaxed text-muted-foreground">
        My work spans astrodynamics research, mechanical design, and weightlifting
        coaching. I focus on indirect optimal control methods and approximation
        techniques for aerospace problems.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="rounded-md bg-primary px-5 py-3 text-sm font-semibold text-white transition-colors hover:opacity-90"
          href="/publications/">Research and publications</a
        >
        <a
          class="rounded-md border border-border px-5 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-muted"
          href="/cv/">Experience and skills</a
        >
        <a
          class="px-3 py-3 text-sm font-semibold text-foreground underline decoration-primary underline-offset-4"
          href={siteConfig.socialLinks.email}>Get in touch</a
        >
      </div>
    </div>
    <figure class="mx-auto w-full max-w-sm md:max-w-none">
      <Image
        src={profileImage}
        alt="Austin Widmer"
        class="aspect-[4/5] w-full object-cover object-center"
        widths={[320, 480, 640]}
        sizes="(min-width: 768px) 30vw, 80vw"
      />
    </figure>
  </section>

  <section class="border-y border-border bg-muted/50">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3 lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase text-primary">Research</p>
        <h2 class="mt-2 text-2xl font-semibold">Astrodynamics and control</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          Work on extremal field maps, indirect optimal control, and numerical
          approximation methods.
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase text-primary">Experience</p>
        <h2 class="mt-2 text-2xl font-semibold">Engineering practice</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          Aerospace research and internships, agricultural machinery design, and
          hands-on technical projects.
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase text-primary">Coaching</p>
        <h2 class="mt-2 text-2xl font-semibold">Weightlifting</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          USA Weightlifting Level 1 coach with experience coaching university
          athletes and building coaching tools.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase text-primary">Selected work</p>
        <h2 class="mt-2 text-3xl font-semibold">Recent publications</h2>
      </div>
      <a
        class="text-sm font-semibold text-foreground underline decoration-primary underline-offset-4"
        href="/publications/">All publications</a
      >
    </div>
    <div class="mt-8 divide-y divide-border border-y border-border">
      {featuredPublications.map((publication) => (
        <article class="grid gap-3 py-6 md:grid-cols-[10rem_1fr] md:gap-8">
          <p class="text-sm text-muted-foreground">
            {publication.data.pubDate.getFullYear()} · {publication.data.venue}
          </p>
          <div>
            <h3 class="text-xl font-semibold">{publication.data.title}</h3>
            <p class="mt-2 max-w-3xl leading-relaxed text-muted-foreground">
              {publication.data.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>