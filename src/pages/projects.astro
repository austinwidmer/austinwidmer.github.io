---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const metadata = {
  title: "Projects | Austin Widmer",
  description: "Selected engineering and coaching projects by Austin Widmer.",
};
const projects = await getCollection("projects");
// Temporarily hide Widmer Training while the application is offline.
const visibleProjects = projects.filter(
  (project) => project.id !== "widmer-training",
);
const renderedProjects = await Promise.all(
  visibleProjects.map(async (project) => ({
    ...project,
    rendered: await render(project),
  })),
);
---

<BaseLayout {metadata}>
  <main class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <header class="mb-12 max-w-3xl">
      <p class="text-sm font-semibold uppercase text-primary">Selected work</p>
      <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Projects</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        A selection of my projects from my work in engineering, software development, and research.
      </p>
    </header>
    <div class="divide-y divide-border border-y border-border">
      {renderedProjects.map(({ data, rendered }) => {
        const { Content } = rendered;

        return (
        <article class="py-8">
          <h2 class="text-2xl font-semibold">{data.title}</h2>
          <p class="mt-3 max-w-3xl leading-relaxed text-muted-foreground">
            {data.description}
          </p>
          <p class="mt-2 text-sm text-muted-foreground">
            Added <time datetime={data.dateAdded.toISOString().slice(0, 10)}>
              {data.dateAdded.toLocaleDateString("en-US", { dateStyle: "long", timeZone: "UTC" })}
            </time>
          </p>
          <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted-foreground">
            {data.tags.map((tag: string) => <li>{tag}</li>)}
          </ul>
          {data.type === "article" ? (
            <div class="prose prose-lg mt-8 max-w-none dark:prose-invert">
              <Content />
            </div>
          ) : (
            <a
              class="mt-5 inline-block text-sm font-semibold underline decoration-primary underline-offset-4"
              href={data.url}
              target="_blank"
              rel="noreferrer"
            >
              Visit project
            </a>
          )}
        </article>
        );
      })}
    </div>
  </main>
</BaseLayout>